# Google OAuth Client ID
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Must match GOOGLE_CLIENT_ID in backend node-api/.env
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# API Base URL
# Local development: http://localhost:5000 (Vite dev server proxies to backend)
# Production: https://futrix-node-api.onrender.com (or your backend URL)
VITE_API_URL=http://localhost:5000
