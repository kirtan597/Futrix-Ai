# ─── Client Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

# Your Google OAuth Client ID (same one used in node-api)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Deployed Node API base URL (no trailing slash)
# In development this is overridden by Vite's proxy, so you can leave it blank
# In production (Vercel) set this to your Railway / Render / etc. API URL
VITE_API_URL=https://your-node-api.railway.app
