MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/futrixai
PORT=5000
# URL of the deployed Python AI service (Railway / Render / etc.)
PYTHON_URL=https://your-python-ai.railway.app
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
NODE_ENV=production
# Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
