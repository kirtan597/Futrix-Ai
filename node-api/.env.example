# PostgreSQL (Supabase) Connection
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# MongoDB URI (Optional: only needed if running data migration script node-api/scripts/migrate-to-supabase.js)
# MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/futrixai?retryWrites=true&w=majority

# Node API Server Port
PORT=5000

# Python AI Service URL
PYTHON_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000/analyze

# JWT Tokens
JWT_SECRET=generate_random_string_here_min_32_characters
JWT_REFRESH_SECRET=generate_another_random_string_here_min_32_characters

# Internal Shared Secret between Node API and Python AI
INTERNAL_API_SECRET=your_shared_internal_secret_here

# Firebase Admin Credentials
# Get from: https://console.firebase.google.com → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
