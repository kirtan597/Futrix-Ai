# MongoDB Atlas Connection
# Get from: https://mongodb.com → Cluster → Connect → Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/futrixai?retryWrites=true&w=majority

# Node API Server Port
PORT=5000

# Python AI Service URL
# Local: http://localhost:8000
# Production: https://futrix-python-ai.onrender.com (or your Python service URL)
PYTHON_URL=http://localhost:8000

# Python AI Analyze Endpoint (usually same as above + /analyze)
AI_SERVICE_URL=http://localhost:8000/analyze

# JWT Tokens - Generate random strings (use: openssl rand -hex 32)
JWT_SECRET=generate_random_string_here_min_32_characters
JWT_REFRESH_SECRET=generate_another_random_string_here_min_32_characters

# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Must match the Client ID in frontend .env
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Environment
# development = local testing with verbose logs
# production = Render/live environment with optimized logs
NODE_ENV=development

# Frontend URL (for CORS)
# Local: http://localhost:5173
# Production: https://futrixai.netlify.app (or your frontend domain)
FRONTEND_URL=http://localhost:5173
